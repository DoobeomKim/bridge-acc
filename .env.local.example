# finAPI Configuration
# Get these from https://oba.prime.vivid.money/
FINAPI_CLIENT_ID=your_client_id_here
FINAPI_CLIENT_SECRET=your_client_secret_here
FINAPI_BASE_URL=https://oba.prime.vivid.money

# Application URL (for OAuth redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encryption key for storing tokens (generate a random string)
TOKEN_ENCRYPTION_KEY=your_32_character_encryption_key

# Anthropic API (for AI quote consulting)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your_api_key_here
ANTHROPIC_RESEARCH_MODEL=claude-sonnet-4-5

# OpenAI API (Growth company research)
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_RESEARCH_MODEL=gpt-5.6-luna
OPENAI_RESEARCH_MAX_TOOL_CALLS=6
OPENAI_RESEARCH_MAX_OUTPUT_TOKENS=6000
OPENAI_RESEARCH_REASONING=low
OPENAI_DISCOVERY_MAX_TOOL_CALLS=6
OPENAI_DISCOVERY_MAX_OUTPUT_TOKENS=7000
OPENAI_REVIEW_MODEL=gpt-5.6-sol
OPENAI_REVIEW_MAX_TOOL_CALLS=8
OPENAI_REVIEW_REASONING=medium
OPENAI_REVIEW_REQUIRES_APPROVAL=true

# Database (Vercel Postgres)
# This will be automatically set by Vercel when you create a Postgres database
DATABASE_URL=postgres://username:password@host/database

# Vercel Blob Storage
# This will be automatically set by Vercel when you enable Blob storage
BLOB_READ_WRITE_TOKEN=vercel_blob_token_here

# Separate equal-authority approver accounts (base64-encoded bcrypt hashes)
DOOBEOM_PASSWORD_HASH=base64_encoded_bcrypt_hash
EURA_PASSWORD_HASH=base64_encoded_bcrypt_hash

# Scheduled automation authentication
CRON_SECRET=generate_a_long_random_secret
JWT_SECRET=generate_a_long_random_secret
